generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum CarBodyType {
  HATCHBACK
  SEDAN
  SUV
  COUPE
  CONVERTIBLE
  MUV
  LUXURY
}

enum FuelType {
  PETROL
  DIESEL
  CNG
  ELECTRIC
  HYBRID
}

enum TransmissionType {
  MANUAL
  AUTOMATIC
  IMT
}

enum OwnerType {
  FIRST
  SECOND
  THIRD
  FOURTH_PLUS
}

enum InsuranceStatus {
  COMPREHENSIVE
  ZERO_DEP
  THIRD_PARTY
  EXPIRED
}

enum CarStatus {
  DRAFT
  LIVE
  RESERVED
  SOLD
  ARCHIVED
}

enum LeadStatus {
  NEW
  CONTACTED
  INSPECTION_SCHEDULED
  EVALUATED_OFFER_MADE
  PURCHASED
  REJECTED
}

enum EnquirySource {
  CAR_DETAIL
  HOME_PAGE
  CONTACT_PAGE
  DIRECT_CALL
}

enum EnquiryStatus {
  NEW
  CONTACTED
  TEST_DRIVE_SCHEDULED
  NEGOTIATION
  WON_SOLD
  LOST
}

enum AdminRole {
  ADMIN
  STAFF
}

// ==========================================
// MODELS
// ==========================================

model CarListing {
  id                 String           @id @default(cuid())
  slug               String           @unique
  title              String           // e.g. "2021 VW Polo GT 1.0 TSI"
  brand              String           // e.g. "Volkswagen"
  model              String           // e.g. "Polo"
  variant            String           // e.g. "GT 1.0 TSI"
  bodyType           CarBodyType
  manufacturingYear  Int
  registrationYear   Int
  registrationState  String           // RTO state code e.g. "DL", "HR", "UP"
  registrationNumber String           // ADMIN-ONLY: sensitive vehicle registration identifier
  ownerType          OwnerType
  kmDriven           Int
  fuelType           FuelType
  transmission       TransmissionType
  colour             String
  insuranceStatus    InsuranceStatus
  insuranceValidTill DateTime?
  price              Int              // In INR, e.g. 895000
  discountedPrice    Int?             // Optional offer price
  discountPercent    Int?             // Computed/stored % off
  currency           String           @default("INR")
  description        String           @db.Text
  highlightTags      String[]         // e.g. ["150+ Checkpoints Certified", "Single Owner"]
  status             CarStatus        @default(LIVE)
  isFeatured         Boolean          @default(false)
  isNewArrival       Boolean          @default(false)
  coverImage         String           // Primary cover photo URL

  images             CarImage[]
  enquiries          BuyerEnquiry[]

  createdById        String?
  createdBy          AdminUser?       @relation(fields: [createdById], references: [id])

  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([status])
  @@index([brand])
  @@index([price])
  @@index([createdAt])
  @@index([isFeatured])
  @@index([isNewArrival])
  @@index([bodyType])
  @@index([fuelType])
  @@index([status, isFeatured, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([status, bodyType])
  @@index([status, brand, price])
  @@map("car_listings")
}

model CarImage {
  id        String     @id @default(cuid())
  carId     String
  car       CarListing @relation(fields: [carId], references: [id], onDelete: Cascade)
  url       String
  order     Int        @default(0)
  isCover   Boolean    @default(false)
  createdAt DateTime   @default(now())

  @@index([carId, order])
  @@map("car_images")
}

model SellerLead {
  id                 String           @id @default(cuid())
  name               String
  mobileNumber       String           // ADMIN-ONLY: Seller contact PII
  whatsappNumber     String?          // ADMIN-ONLY: Seller contact PII
  city               String
  registrationNumber String           // ADMIN-ONLY: Seller car registration
  registrationState  String           // e.g. "DL", "HR"
  manufacturingYear  Int
  registrationYear   Int
  ownerType          OwnerType
  brand              String
  modelName          String
  variant            String?
  kmDrivenRange      String           // e.g. "20,000 - 40,000 km"
  fuelType           FuelType
  transmissionType   TransmissionType
  expectedPrice      Int              // Seller asking price in INR
  photos             String[]         // Optional uploaded image URLs
  status             LeadStatus       @default(NEW)
  internalNotes      String?          @db.Text // ADMIN-ONLY: Inspection remarks

  assignedToId       String?
  assignedTo         AdminUser?       @relation(fields: [assignedToId], references: [id])

  convertedCarId     String?          @unique

  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([brand])
  @@map("seller_leads")
}

model BuyerEnquiry {
  id           String        @id @default(cuid())
  relatedCarId String?
  relatedCar   CarListing?   @relation(fields: [relatedCarId], references: [id], onDelete: SetNull)
  name         String
  phone        String        // ADMIN-ONLY: Buyer contact PII
  email        String?       // ADMIN-ONLY: Buyer contact PII
  message      String?       @db.Text
  source       EnquirySource @default(CAR_DETAIL)
  status       EnquiryStatus @default(NEW)

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([relatedCarId])
  @@index([status])
  @@index([createdAt])
  @@map("buyer_enquiries")
}

model AdminUser {
  id            String       @id @default(cuid())
  name          String
  email         String       @unique
  passwordHash  String       // ADMIN-ONLY: Bcrypt hash
  role          AdminRole    @default(ADMIN)
  lastLogin     DateTime?

  createdCars   CarListing[]
  assignedLeads SellerLead[]

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@map("admin_users")
}

model Banner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  image     String
  link      String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([active, order])
  @@map("banners")
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  city      String?
  photo     String?
  quote     String   @db.Text
  carBought String
  rating    Int      @default(5)
  featured  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([featured])
  @@map("testimonials")
}

model FAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String   @db.Text
  category  String   @default("General") // e.g. "Buying", "Selling", "Financing", "Warranty"
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([active, order])
  @@map("faqs")
}

model StaticPage {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  content   String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("static_pages")
}
