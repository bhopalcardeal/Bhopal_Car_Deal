# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres:password@host:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:password@host:5432/postgres"

# NextAuth v5 Authentication
NEXTAUTH_SECRET="super-secret-key-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Dealership Contact & WhatsApp Number
NEXT_PUBLIC_WHATSAPP_NUMBER="9999999999"

# Cloudinary Media Storage (for vehicle image uploads)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
CLOUDINARY_FOLDER="bhopal_car_deal" # Optional: customize your Cloudinary asset folder

# Vercel Cron Security Secret (Optional: automatically passed by Vercel if set in Vercel project settings)
CRON_SECRET="optional_random_32_char_secret"
